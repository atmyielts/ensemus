{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.ensemus.invalid/agent-definition.v1.json",
  "title": "Ensemus Agent Version v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "version", "objective", "model", "context", "tools", "execution", "output", "evaluation"],
  "properties": {
    "api_version": {"type": "string", "const": "ensemus.ai/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,80}$"},
    "version": {"type": "integer", "minimum": 1},
    "objective": {"type": "string", "minLength": 10, "maxLength": 1000},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["required_capabilities", "quality_tier", "fallback"],
      "properties": {
        "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "quality_tier": {"enum": ["economy", "balanced", "high"]},
        "fallback": {"enum": ["approved_profiles_only", "disabled"]}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_scopes", "memory_write_policy"],
      "properties": {
        "allowed_scopes": {"type": "array", "items": {"type": "string"}},
        "memory_write_policy": {"enum": ["none", "propose_only", "verified_by_policy"]},
        "max_input_tokens": {"type": "integer", "minimum": 128}
      }
    },
    "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "tools": {
      "type": "object", "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "deny": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["max_model_turns", "max_tool_calls", "max_cost_usd", "timeout_seconds", "max_delegation_depth"],
      "properties": {
        "max_model_turns": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 500},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_delegation_depth": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "verification"],
      "properties": {
        "schema_ref": {"type": "string"},
        "verification": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["suite_ref", "min_pass_rate"],
      "properties": {
        "suite_ref": {"type": "string"},
        "min_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
