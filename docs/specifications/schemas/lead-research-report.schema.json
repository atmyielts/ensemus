{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.ensemus.invalid/lead-research-report.v1.json",
  "title": "Evidence-backed Lead Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_ref", "summary", "findings", "limitations", "created_at"],
  "properties": {
    "account_ref": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "evidence"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_ref", "source_version"],
              "properties": {
                "source_ref": {"type": "string", "minLength": 1},
                "source_version": {"type": "string", "minLength": 1},
                "citation_span": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
