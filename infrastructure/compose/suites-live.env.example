# Copy to .local/suites-live.env (ignored by git) and fill in the two client IDs.
# Client secrets never go in this file: put each in its own file under .local/secrets/oauth/.
# See docs/06-delivery/suites-live-run.md.

ENSEMUS_PUBLIC_URL=https://localhost:8443
ENSEMUS_CONNECTORS_ENABLED=true

# Public client IDs of the test apps you registered (Google Cloud and Microsoft Entra).
ENSEMUS_GOOGLE_CLIENT_ID=
ENSEMUS_MICROSOFT_CLIENT_ID=

# One target per route. TLS names are fixed in code, so each gateway can only carry its own host.
ENSEMUS_EGRESS_GOOGLE_API_TARGET=www.googleapis.com:443
ENSEMUS_EGRESS_GOOGLE_OAUTH_TARGET=oauth2.googleapis.com:443
ENSEMUS_EGRESS_GOOGLE_GMAIL_TARGET=gmail.googleapis.com:443
ENSEMUS_EGRESS_GOOGLE_DOCS_TARGET=docs.googleapis.com:443
ENSEMUS_EGRESS_GOOGLE_SHEETS_TARGET=sheets.googleapis.com:443
ENSEMUS_EGRESS_MS_GRAPH_TARGET=graph.microsoft.com:443
ENSEMUS_EGRESS_MS_LOGIN_TARGET=login.microsoftonline.com:443

# The SMTP gateway refuses to start without a target, and the connector worker waits for it. Nothing in
# this run sends SMTP, so it points at a port that answers nothing.
ENSEMUS_EGRESS_TARGET=127.0.0.1:9
