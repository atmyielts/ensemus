# Next.js standalone image (PLAT-11). Built with no secrets; everything sensitive arrives at runtime.
FROM node:24-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter "@ensemus/web..."
ARG ENSEMUS_RELEASE=local
ENV ENSEMUS_RELEASE=$ENSEMUS_RELEASE
RUN pnpm --filter @ensemus/web build
# Images are unoptimized, so the LGPL image library Next.js traces in is unused. Keep it out.
RUN find apps/web/.next/standalone -type d \( -path '*@img*' -o -name 'sharp' -o -name 'sharp@*' -o -name '@img+*' \) -prune -exec rm -rf {} +

FROM node:24-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/start.mjs /repo/apps/web/healthcheck.mjs /repo/apps/web/no-script-not-found.mjs ./apps/web/
RUN mkdir -p /app/apps/web/.next/cache && chown -R node:node /app/apps/web/.next/cache
USER node
WORKDIR /app/apps/web
HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=10s CMD ["node", "healthcheck.mjs"]
CMD ["node", "start.mjs"]
